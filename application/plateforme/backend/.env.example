# MongoDB Database Connection String
MONGO_URI=mongodb://127.0.0.1:27017/attendance_db

# Security & JWT Tokens
JWT_SECRET=your_ultra_secure_jwt_secret_key

# Express Server Port
PORT=5000

# Email Sending Service (Nodemailer / Gmail App Password)
GMAIL_USER=your_email@gmail.com
GMAIL_PASS=your_gmail_app_password

# Hardware Terminal Authentication Key (ESP32 Device Key)
DEVICE_KEY=your_secret_esp32_device_key_2026

# Administrator Credentials
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@biopulse.com
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_PIN=123123
ADMIN_PIN_HASH=your_bcrypt_pin_hash
